flowchart TB
    Client([Client App])

    subgraph Security["Edge & Auth"]
        WAF["AWS WAF<br/>Rate-based rule<br/>1000 req / 5 min per IP"]
        Cognito["Cognito User Pool<br/>JWT Authorizer"]
    end

    subgraph APIGW["API Gateway REST API — OrdersApi (prod stage)"]
        Cache["Stage Cache<br/>TTL 300s"]
        POST["POST /orders"]
        GET["GET /orders/{orderId}"]
    end

    subgraph Compute["Compute"]
        Lambda["Lambda: SaveOrder<br/>Node.js 24.x<br/>X-Ray tracing ON<br/>init outside handler"]
    end

    subgraph DataLayer["DynamoDB Global Table — Orders"]
        DDBPrimary[("Primary<br/>us-east-1<br/>PK orderId / SK itemId<br/>Streams: NEW_AND_OLD_IMAGES")]
        DDBReplica[("Replica<br/>us-west-2<br/>Disaster Recovery")]
    end

    subgraph Observability["Observability"]
        Dashboard["CloudWatch Dashboard<br/>API Count / 4XXError<br/>Lambda Invocations / Errors"]
        XRay["AWS X-Ray Traces"]
    end

    subgraph CICD["CI/CD"]
        GH["GitHub Actions<br/>push to main → sam deploy<br/>AWS creds via repo secrets"]
    end

    Client --> WAF --> Cache
    Cache --> POST
    Cache --> GET
    POST -. requires JWT .-> Cognito
    GET -. requires JWT .-> Cognito

    POST --> Lambda
    Lambda -->|"PutItem (write)"| DDBPrimary
    GET -->|"Direct AWS integration<br/>DynamoDB Query via IAM role<br/>(no Lambda)"| DDBPrimary

    DDBPrimary <-->|"Stream-based<br/>replication"| DDBReplica

    Lambda -.-> XRay
    Lambda -.-> Dashboard
    APIGW -.-> Dashboard

    GH -. deploys .-> APIGW
    GH -. deploys .-> Lambda
    GH -. deploys .-> DataLayer

